// This file is part of the ShadowMesh public UI layer, published for
// independent security audit. See docs/LICENSING.md.

// `AboutSlint` is the upstream Slint attribution widget, re-exported by every
// style (cupertino/fluent/material/cosmic all do
// `export { AboutSlint } from "../common/about-slint.slint";`).
// Slint's royalty-free licence §2(a) requires this widget to be displayed in
// an "About" screen or dialog reachable from the application's top level
// menu. See apps/desktop-native/src/attribution.rs for the licence citation
// and the artefact-level check that enforces it.
import { Button, VerticalBox, HorizontalBox, ScrollView, AboutSlint, Palette } from "std-widgets.slint";

// ============================================================
// Glimmer Design System — Motion Tokens (design-system/02, 03)
// No linear transitions. Spring-emulated curves, interruptible
// by design (Slint retargets animations on state change).
// Overshoot <= 10% per the Physics Bar: premium, never toy-like.
// ============================================================
export global Motion {
    // Mass hierarchy: heavier elements move with more effort
    out property <duration> fast: 120ms;      // icons, knobs, presses
    out property <duration> medium: 200ms;    // rows, chips, toggles
    out property <duration> heavy: 280ms;     // sheets / panels
    // Spring curves are inlined at call sites (<easing> not yet
    // supported in public/global API): spring-out = (0.34,1.30,0.64,1),
    // emphasized = (0.2,0.8,0.2,1)
}

// The manifest row, as THIS surface can carry it.
//
// RFC-051 §2.1 (F103-9): the row's field set is a property of the SURFACE.
// The manifest row is a **listing** of four published fields — `id`,
// `country`, `region`, `is_online` — and **no others, in every projection**.
//
// ⚠️ `name`, `latency` and `is_sovereign` are GONE, and they are gone
// because Slint's `bool` has **no third state** (RFC-051 §2.2): an
// `Option<bool>` crossing into a Slint `bool` is `None → false`, and a
// defaulted `bool` is `false`. **Both are the fabrication** — `false` about
// sovereignty is a jurisdictional claim about a node this client never asked
// about, and `0ms` is a measurement nobody took. The only representation of
// *"not carried"* that survives is **the absence of the field**.
//
// ⚠️ And a field this surface does not carry has **NO COLUMN**: `WITHHELD`
// is a *cell-level* rendering — a value the surface **does** carry and
// cannot fill (L10's RP-10) — and this surface has no such cell. The
// dashboard does both; the desktop's matrix does only the second
// (`FleetHealthPage.tsx:147` vs `:183-200`).
export struct MeshNode {
    id: string,
    region: string,
    // ISO country code from the server manifest ("SG", "US", ...). Empty
    // string for legacy nodes; the matrix header falls back to region.
    country: string,
    // Whether the node is currently reachable. Carried because it is a
    // **published** field of the row (RFC-051 §2.1) — and it is the only
    // field this surface carries that had no other home: it fills the
    // latency pill's old slot as the row's trailing status, a 12px marker
    // plus the word (L6, `design-system/ROSTER-ROW-READOUT.md` §5).
    //
    // ⚠️ It is a PER-NODE fact, not a roster state, and it does not enter
    // L6's closed set of roster readings: it borrows the house ramp
    // (`--cmd-online*` / `--cmd-offline*`) and nothing else.
    is_online: bool,
}

// Pre-grouped node sections for the matrix: Rust builds these so the
// Slint layer stays declarative (no index math in the markup).
export struct CountryGroup {
    label: string,
    nodes: [MeshNode],
}

// ------------------------------------------------------------
// PhysicsButton — tactile press physics (03_Physics_Engine.md §3)
// Press: instant compression (light mass). Release: elastic rebound.
// AAA: keyboard focus ring + Enter/Space activation.
// ------------------------------------------------------------
component PhysicsButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    in-out property <length> base-height: 48px;
    height: base-height * (touch.pressed ? 0.97 : 1.0);
    animate height {
        duration: touch.pressed ? Motion.fast : Motion.medium;
        easing: cubic-bezier(0.34, 1.30, 0.64, 1);
    }

    border-radius: 12px;

    // Elevation: pressed sinks toward the glass (optical depth)
    background: touch.pressed ? #4F46E566 : (touch.has-hover ? #6E76F2 : #6366F1);
    animate background { duration: Motion.fast; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

    border-width: 1px;
    border-color: kb.has-focus ? #A5B4FC88 : transparent;
    animate border-color { duration: Motion.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    kb := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                root.clicked();
                accept
            }
            reject
        }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: 0.15rem;
            color: #FFFFFF;
        }
    }
}

// ------------------------------------------------------------
// ToggleSwitch — Apple-grade thumb physics
// Press swells the thumb (mass perception); release springs it to
// its rest position with elastic overshoot. Interruptible anytime.
// ------------------------------------------------------------
component ToggleSwitch inherits Rectangle {
    in-out property <bool> active: false;
    callback toggled(bool);

    width: 44px;
    height: 26px;
    border-radius: self.height / 2;
    background: active ? #10B981 : #1E293B;
    animate background { duration: Motion.medium; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

    border-width: 1px;
    border-color: kb.has-focus ? #A5B4FC88 : #334155;
    animate border-color { duration: Motion.fast; }

    touch := TouchArea {
        clicked => {
            root.active = !root.active;
            root.toggled(root.active);
        }
        mouse-cursor: pointer;
    }
    kb := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                root.active = !root.active;
                root.toggled(root.active);
                accept
            }
            reject
        }
    }

    // Thumb: travels to its rest position on a spring curve
    Rectangle {
        property <length> rest-x: root.active ? root.width - self.width - 3px : 3px;
        x: rest-x;
        y: (parent.height - self.height) / 2;
        width: touch.pressed ? 24px : 20px;
        height: 20px;
        border-radius: self.width / 2;
        background: #FFFFFF;

        animate x { duration: Motion.medium; easing: cubic-bezier(0.34, 1.30, 0.64, 1); }
        animate width { duration: Motion.fast; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
}

// ------------------------------------------------------------
// TextLink — text-as-action with AAA hinge: visible focus ring +
// keyboard activation (Enter/Space). Use this for all text-level
// actions so keyboard users get an actual tab-stop.
// ------------------------------------------------------------
component TextLink inherits Rectangle {
    in property <string> label;
    in property <color> text-color: #6366F1;
    // Text size override. Defaults to the historical 9px so every existing
    // call site is byte-for-byte unchanged; a new surface that has to meet
    // the legibility floor passes an explicit size (12px is the floor this
    // app already documents for itself — see the pairing copy below).
    in property <length> font-size: 9px;
    callback clicked;

    border-radius: 6px;
    border-width: 1px;
    border-color: kb.has-focus ? #A5B4FC88 : transparent;
    animate border-color { duration: Motion.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    kb := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                root.clicked();
                accept
            }
            reject
        }
    }

    HorizontalLayout {
        alignment: center;
        padding: 6px;
        Text {
            text: root.label;
            font-size: root.font-size;
            font-weight: 900;
            color: root.text-color;
            horizontal-alignment: center;
        }
    }
}

// ------------------------------------------------------------
// CountryHeader — section divider for the grouped node matrix.
//
// L6, `design-system/ROSTER-ROW-READOUT.md` §3.1: the country is the
// **sectioning** — a published label, nothing more. It is 12px, weight
// 900, tracked 0.12rem, in `--cmd-text-aaa-dim` `#B6C2CF`.
//
// ⚠️ The header is NOT brighter than its contents: the sectioning is
// STRUCTURE and the id is CONTENT, so the hierarchy is carried by weight,
// case, tracking and the rule — not by a brighter colour.
//
// ⚠️ The rule is DECORATIVE and is exempt from 1.4.11: `#1E293B` on the
// panel `#0C1222` measures 1.28:1, and the sectioning is carried by the
// LABEL, which has its own 7:1 assertion (L6 §3.1).
//
// ⚠️ **NO COUNT.** A count per section is banned everywhere (L10 §3.1),
// and a count is convertible into the withheld count by anyone who knows
// the fleet size — which is public knowledge in this product.
//
// ⚠️ The header is not a heading for the screen reader: it is the visible
// section label, and the row beneath it is one merged node (A-5).
// ------------------------------------------------------------
component CountryHeader inherits Rectangle {
    in property <string> label;

    height: 24px;
    background: transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: space-between;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            // ⚠️ 12px — the A-4 type floor. This line was 9px, which is
            // below the floor (L6 §7.1).
            font-size: 12px;
            font-weight: 900;
            color: #B6C2CF; // --cmd-text-aaa-dim
            letter-spacing: 0.12rem;
            vertical-alignment: center;
        }
        // The decorative rule to the panel's edge. NOT a 3:1 non-text
        // object: it carries no meaning (L6 §3.1).
        Rectangle { height: 1px; background: #1E293B; }
    }
}

// ------------------------------------------------------------
// NodeRow — the manifest row's read-out.
//
// L6, `design-system/ROSTER-ROW-READOUT.md` §3.1 (2026-10-21):
//
//   the gutter (leading) | NOTHING — a fixed 12px, always empty
//   the primary line     | the id — 12px, weight 700, MONOSPACE, #F1F5F9
//   the secondary line   | the region — 12px, weight 400, sans, #B6C2CF
//   the trailing slot    | the node status — a 12px marker + the 12px word
//   the section header   | the country — see `CountryHeader`
//
// ⚠️ **The row carries NO sovereignty signal, in any form.** The field is
// not on this surface (RFC-051 §2.1), and every substitute L6 named and
// refused — a `WITHHELD` cell, a country/region/id-derived stripe, a count
// or a legend, a server-carried stripe — is a claim this client cannot make
// (L10's truth rule, L6 §4). **The gutter is the SPECIFICATION, not a gap
// waiting to be filled**: an empty gutter is not a defect to be "fixed".
//
// ⚠️ The id is MONOSPACE and the region is not: an opaque identifier is a
// machine artefact and a place-name is a human one, and a column of
// monospace ids ALIGNS, so the eye scans a list of handles rather than a
// ragged left edge. That is the mechanism by which the row reads as DATA.
//
// ⚠️ The status is carried by THREE channels — the word, the marker's shape
// and the hue — and the hue is redundant: ONLINE is a FILLED DISC and
// OFFLINE is a HOLLOW RING, so removing the colour removes neither channel
// (WCAG 1.4.1; L6 §5.2, §7.3).
//
// ⚠️ **NO MOTION carries this state.** The marker is static: it does not
// pulse, blink, shimmer or animate. The row's hover lift animates the FILL
// — a hover affordance, not a state — and both of its endpoints are
// measured, so nothing about the state is lost under
// `ANIMATOR_DURATION_SCALE == 0` (L6 §5.4).
// ------------------------------------------------------------
component NodeRow inherits Rectangle {
    in property <MeshNode> node;
    in property <bool> camouflaged;

    // ⚠️ 56px: the row grew from 52px to carry the 12px type (L6 §3.1,
    // §9.1 item 7). The matrix stays scrollable and clips no row.
    min-height: 56px;
    background: lift.has-hover ? #FFFFFF0D : #FFFFFF05;
    border-radius: 10px;
    border-width: 1px;
    border-color: lift.has-hover ? #6366F155 : #FFFFFF0A;
    animate background { duration: Motion.medium; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    animate border-color { duration: Motion.medium; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

    // ⚠️ ONE merged accessible node per row (A-5): the name carries the
    // visible words in reading order — "<id>, <region>, ONLINE" — and the
    // loose Text fragments inside carry `accessible-role: none`, so they
    // are not announced as separate nodes. There is NO live region (A-6).
    accessible-role: list-item;
    accessible-label: (camouflaged ? "0x" : "") + node.id
        + (camouflaged ? "" : ", " + node.region)
        + ", " + (node.is_online ? "ONLINE" : "OFFLINE");

    lift := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: space-between;
        padding-left: 0px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        cross-axis-alignment: center;

        // ---- THE LEADING GROUP: the gutter and the two text lines ----
        HorizontalLayout {
            spacing: 0px;
            cross-axis-alignment: center;

            // ⚠️ **THE GUTTER — a FIXED 12px, and it is ALWAYS EMPTY.**
            // This is the slot the sovereignty stripe used to occupy. It is
            // kept so that every id starts at the same x whatever the row
            // carries: a row whose layout is conditional stops reading as a
            // list (L6 §3.2). Nothing goes here.
            Rectangle {
                width: 12px;
                height: 12px;
                background: transparent;
                border-width: 0px;
            }

            VerticalBox {
                alignment: center;
                spacing: 0px;
                // The row's primary line is the node's **ID**, in both
                // postures. There is no name to show: a peer name is banned
                // on a client surface in any state (L6 §4.3 row 5), and the
                // row may not render a field it does not carry (RFC-051
                // §2.1). The camouflaged posture keeps its `0x` form.
                Text {
                    text: (camouflaged ? "0x" : "") + node.id;
                    // ⚠️ 12px — the A-4 type floor. This line was 11px.
                    font-size: 12px;
                    font-weight: 700;
                    font-family: "Monospace";
                    color: #F1F5F9; // --cmd-text-strong
                    accessible-role: none;
                }
                // The secondary line is the region — the server's own
                // published geography, at the server's own granularity, and
                // never a statistic over it (L10 §3.2).
                //
                // ⚠️ **This line was 8px in `#64748B` — 3.76:1 on this row.**
                // That is a double failure: below the 12px floor AND below
                // the 7:1 text floor (L6 §7.1). It is re-stepped to 12px in
                // `--cmd-text-aaa-dim` `#B6C2CF`, which measures 9.88:1 on
                // the row and 9.19:1 on the hovered row.
                //
                // ⚠️ **L10's C-4: in a DISGUISED posture the row renders NO
                // region.** The exit node's geography is a location
                // inference about the user (L10 §3.2), and "a disguise that
                // leaves the geography visible is a partial disguise".
                // ⇒ The region is MASKED in the disguise; nothing is
                // invented in its place, and the row's anatomy is otherwise
                // unchanged.
                if (!camouflaged) : Text {
                    text: node.region;
                    font-size: 12px;
                    color: #B6C2CF; // --cmd-text-aaa-dim
                    accessible-role: none;
                }
            }
        }

        // ---- THE TRAILING SLOT: the node's status ----
        //
        // The latency pill's slot, re-filled with the one published field
        // that had no other home: `is_online` (RFC-051 §2.1; L6 §5.1).
        // ⚠️ There is NO latency here — nobody took a measurement — and no
        // `0ms`, ever.
        HorizontalLayout {
            spacing: 6px;
            cross-axis-alignment: center;

            // The marker: a FILLED DISC when online, a HOLLOW RING when
            // offline. Both 12px, optically matched to the type, and both
            // distinguishable with the colour removed entirely (1.4.1).
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: node.is_online ? #10B981 : transparent; // --cmd-online
                border-width: node.is_online ? 0px : 2px;
                border-color: node.is_online ? transparent : #EF4444; // --cmd-offline
            }
            Text {
                text: node.is_online ? "ONLINE" : "OFFLINE";
                font-size: 12px;
                font-weight: 700;
                // --cmd-online-aaa / --cmd-offline-aaa. ⚠️ The WORD is a
                // text token: the non-text step (#10B981) measures 7.05:1
                // and would fail AAA's 7:1 for text.
                color: node.is_online ? #34D399 : #FCA5A5;
                accessible-role: none;
            }
        }
    }
}

// ------------------------------------------------------------
// RosterStateLine — the roster's CONDITION, on its own line.
//
// L6, `design-system/ROSTER-ROW-READOUT.md` §6.2: the roster state gets
// its OWN element, **immediately under the matrix panel**
// (`sm.roster.underList`). It is present in EVERY state, and it is
// suppressed — whole — in a disguised posture.
//
// ⚠️ WHY IT IS NOT THE STATUS CARD (F-7): the desktop's status area is
// SINGLE-SLOT. Every status in `main.rs` was written into one string and
// rendered as the status card's 20px main line — the same slot the roster
// state was written into — so the roster state line was present ONLY when
// the last event happened to be a manifest read. That is a live violation
// of A-10 and of L10's RP-19 ("the state line is present in every state"),
// and it is the "absence is a signal" defect M-6 names: on this surface
// the ABSENCE of the roster state meant "the connection changed", which is
// an account-adjacent fact leaking through the roster surface.
//
// ⚠️ The content is L6's §2.3 SHORT LABEL, alone. The `MESH SYNCED — `
// prefix is DROPPED: it is a relationship claim about the connection
// (L10's M-9), which the status card already states, and it is false in
// the states it cannot survive.
//
// ⚠️ The marker is the per-state shape from L6's §3.3, 12px, in the
// state's marker token; the label is in the state's text token; and the
// two are ONE merged accessible node — the name is the short label and the
// description is the §2.3 long form (A-5).
//
// ⚠️ There is NO live region and nothing ever notifies (A-6, RP-14,
// RP-13): a screen-reader announcement is audible in a café, and is the
// worst possible surface for shoulder-surfing.
//
// ⚠️ The state ids below MUST match `RosterState::id()` in `src/rfc051.rs`.
// The gate that keeps them in step is `the_state_ids_match_the_slint_states`
// in that file.
// ------------------------------------------------------------
component RosterStateLine inherits Rectangle {
    in property <int> state-id: 0;
    in property <string> label: "";
    in property <string> long-form: "";

    height: 20px;
    background: transparent;

    // ONE merged accessible node: the name is the short label, the
    // description is the long form (L6 §3.5, A-5).
    accessible-role: text;
    accessible-label: root.label;
    accessible-description: root.long-form;

    HorizontalLayout {
        alignment: start;
        padding-left: 8px;
        spacing: 8px;
        cross-axis-alignment: center;

        // ⚠️ The marker SLOT is a fixed 12px and it is always present, so
        // the label's x does not move when a state carries no marker
        // (`pending` — "not asked yet" is not a state of the data, L6 §3.3).
        Rectangle {
            width: 12px;
            height: 12px;
            background: transparent;
            border-width: 0px;

            // ---- state 0 — FULL ROSTER: a filled check ----
            if (root.state-id == 0) : Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: transparent;
                stroke: #10B981; // --cmd-online
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                MoveTo { x: 2; y: 6.4; }
                LineTo { x: 5; y: 9.4; }
                LineTo { x: 10; y: 3; }
            }

            // ---- state 1 — REDUCED ROSTER: a half-filled circle ----
            if (root.state-id == 1) : Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: #F59E0B; // --cmd-warning
                stroke: transparent;
                MoveTo { x: 6; y: 1; }
                ArcTo { radius-x: 5; radius-y: 5; large-arc: false; sweep: false; x-rotation: 0; x: 6; y: 11; }
                Close { }
            }
            if (root.state-id == 1) : Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: transparent;
                stroke: #F59E0B; // --cmd-warning
                stroke-width: 2px;
                MoveTo { x: 6; y: 1; }
                ArcTo { radius-x: 4.8; radius-y: 4.8; large-arc: false; sweep: true; x-rotation: 0; x: 6; y: 11; }
                ArcTo { radius-x: 4.8; radius-y: 4.8; large-arc: false; sweep: true; x-rotation: 0; x: 6; y: 1; }
                Close { }
            }

            // ---- state 2 — NOT FROM THE CONTROL PLANE: a hollow circle
            // with a centre dot ----
            if (root.state-id == 2) : Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: transparent;
                stroke: #B6C2CF; // --cmd-text-aaa-dim
                stroke-width: 2px;
                MoveTo { x: 6; y: 1; }
                ArcTo { radius-x: 4.8; radius-y: 4.8; large-arc: false; sweep: true; x-rotation: 0; x: 6; y: 11; }
                ArcTo { radius-x: 4.8; radius-y: 4.8; large-arc: false; sweep: true; x-rotation: 0; x: 6; y: 1; }
                Close { }
            }
            if (root.state-id == 2) : Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: #B6C2CF; // --cmd-text-aaa-dim
                stroke: transparent;
                MoveTo { x: 6; y: 4.4; }
                ArcTo { radius-x: 1.6; radius-y: 1.6; large-arc: false; sweep: true; x-rotation: 0; x: 6; y: 7.6; }
                ArcTo { radius-x: 1.6; radius-y: 1.6; large-arc: false; sweep: true; x-rotation: 0; x: 6; y: 4.4; }
                Close { }
            }

            // ---- state 3 — ROSTER UNREADABLE: a question mark in a
            // triangle ----
            if (root.state-id == 3) : Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: transparent;
                stroke: #B6C2CF; // --cmd-text-aaa-dim
                stroke-width: 1.2px;
                stroke-line-join: round;
                MoveTo { x: 6; y: 0.6; }
                LineTo { x: 11.4; y: 11.4; }
                LineTo { x: 0.6; y: 11.4; }
                Close { }
            }
            if (root.state-id == 3) : Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: transparent;
                stroke: #B6C2CF; // --cmd-text-aaa-dim
                stroke-width: 1.2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                MoveTo { x: 4.8; y: 4.4; }
                LineTo { x: 5.4; y: 3.4; }
                LineTo { x: 6.4; y: 3.2; }
                LineTo { x: 7.2; y: 4; }
                LineTo { x: 7; y: 5.2; }
                LineTo { x: 6; y: 5.9; }
                LineTo { x: 6; y: 6.8; }
            }
            if (root.state-id == 3) : Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: #B6C2CF; // --cmd-text-aaa-dim
                stroke: transparent;
                MoveTo { x: 6; y: 7.8; }
                ArcTo { radius-x: 0.9; radius-y: 0.9; large-arc: false; sweep: true; x-rotation: 0; x: 6; y: 9.6; }
                ArcTo { radius-x: 0.9; radius-y: 0.9; large-arc: false; sweep: true; x-rotation: 0; x: 6; y: 7.8; }
                Close { }
            }

            // ---- state 4 — UNAVAILABLE: a cross ----
            if (root.state-id == 4) : Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: transparent;
                stroke: #EF4444; // --cmd-offline
                stroke-width: 2px;
                stroke-line-cap: round;
                MoveTo { x: 1.6; y: 1.6; }
                LineTo { x: 10.4; y: 10.4; }
            }
            if (root.state-id == 4) : Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: transparent;
                stroke: #EF4444; // --cmd-offline
                stroke-width: 2px;
                stroke-line-cap: round;
                MoveTo { x: 10.4; y: 1.6; }
                LineTo { x: 1.6; y: 10.4; }
            }

            // ---- state 5 — READING THE ROSTER: NO MARKER ----
            // "Not asked yet" is not a state of the data (L6 §3.3), and a
            // spinner would be MOTION carrying a state (A-7/A-8).
        }

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 700;
            // The state's TEXT token (L6 §3.2): --cmd-online-aaa /
            // --cmd-warning-aaa / --cmd-accent-aaa / --cmd-offline-aaa, and
            // --cmd-text-aaa-dim for the two states L6's token table does
            // not name (`unreadable`, `pending`). No new colours.
            color: root.state-id == 0 ? #34D399
                : root.state-id == 1 ? #FBBF24
                : root.state-id == 2 ? #93C5FD
                : root.state-id == 4 ? #FCA5A5
                : #B6C2CF;
            accessible-role: none;
        }
    }
}

// ------------------------------------------------------------
// AboutWindow — the "About screen" of §2(a).
//
// Slint Royalty-free Desktop, Mobile, and Web Applications License v2.0,
// §2 "License Conditions - Attribution" (the vendored text is
// apps/desktop-native/LICENSES/LicenseRef-Slint-Royalty-free-2.0.md):
//
//   "(a) Display the [`AboutSlint`] widget in an "About" screen or dialog
//    that is accessible from the top level menu of the Application. In the
//    absence of such a screen or dialog, display the widget in the "Splash
//    Screen" of the Application."
//
// This component IS that screen. The `AboutSlint` widget is upstream's and
// is used unmodified: it carries the brand asset, the version string and the
// licence-mandated link. It must not be re-skinned or re-implemented — what
// the licence asks to be displayed is the widget itself.
//
// A separate top-level window rather than an inline sheet: the licence asks
// for a screen or dialog that is "accessible from the top level menu", and a
// dedicated window is the unambiguous reading of that. It also keeps the
// mesh view behind it untouched.
//
// NOTE ON SHAPE (learned the hard way, 2026-10-20): Slint 1.17 generates Rust
// code ONLY for exported components that inherit `Window`. The attribution
// surface therefore has to be ONE exported Window — the panel is inlined
// below rather than being a separate exported component.
//
// AAA notes for L6/L6-C (see the dispatch notes):
//
//   ⚠️ CORRECTED 2026-10-21 (L7). This block previously read "Heading
//   #F1F5F9 on #0F172A — 16.5:1" and "Body #94A3B8 on #0F172A — 7.06:1", and
//   the second figure — being over 7 — read as an AAA PASS. Recomputed with
//   the WCAG 2.x relative-luminance formula (self-checked against the three
//   W3C worked examples: 21.0 / 4.48 / 7.00), the real figures are:
//
//     * Heading  #F1F5F9 on #0F172A — 16.30:1  → PASS (AAA needs 7:1)
//     * Body    #94A3B8 on #0F172A —  6.96:1  → **FAIL** (AAA needs 7:1)
//
//   6.96 is BELOW 7. The comment asserted a compliance that does not exist,
//   and the gap is invisible unless the ratio is recomputed. All three About
//   text runs are 12px — normal text, so the 7:1 AAA floor applies, not the
//   4.5:1 AA floor.
//
//   ⚠️ NOT FIXED HERE, AND DELIBERATELY SO. #94A3B8 is this app's EXISTING
//   muted-text step — 9 call sites in this file already use it — so re-stepping
//   it in one surface would make the About screen read differently from every
//   other screen, which is a coherence regression, and the whole-client
//   re-step is a token decision that belongs to L6 (the desktop client has no
//   token layer of its own: see design-system/tokens.json OQ-4). The
//   app-wide condition, not this surface, is what L6/L6-C must rule on.
//   L7's own measurement, for that ruling:
//     * #94A3B8 on #0F172A = 6.96:1  (the step in use — 0.04 short of 7:1)
//     * #A5B4FC on #0F172A = 8.96:1  (already in this file, as the focus ring)
//     * #CBD5E1 on #0F172A = 12.02:1 (design-system --cmd-text-aaa)
//     * #F1F5F9 on #0F172A = 16.30:1 (already in this file, as the heading)
//
//   * The CLOSE control is 12px (the legibility floor this app documents
//     for itself) with the app's existing focus-ring token. That focus ring
//     is #A5B4FC88, which composites to #5F6B9A on #0F172A = 3.45:1 against
//     the WCAG 1.4.11 non-text floor of 3:1 → PASS. The control is
//     keyboard-activatable via the shared TextLink pattern: its FocusScope
//     keeps Slint's default `focus-on-tab-navigation: true`, and its
//     `key-pressed` accepts " " and "\n".
//   * The upstream widget announces itself to a screen reader as
//     "#MadeWithSlint" (about-slint.slint:21). That string is upstream's and
//     is not ours to change; whether it is an acceptable announcement in this
//     app's About screen is L6's call.
//   * WHAT L7 COULD NOT CHECK WITHOUT RUNNING IT: the rendered contrast of
//     the UPSTREAM widget's own "Version 1.17.1 / https://slint.dev/" text.
//     about-slint.slint:24-28 sets no colour, so it inherits the palette
//     foreground, which flips with the colour scheme — while this plate is
//     pinned to #0F172A (dark) or white by `Palette.color-scheme`. That
//     pairing needs a render to confirm.
// ------------------------------------------------------------
export component AboutWindow inherits Window {
    title: "About ShadowMesh";
    width: 420px;
    height: 460px;
    background: #0F172A; // Slate 900 — the app's window surface

    // Raised by the "CLOSE" control below. Named `request_close` and not
    // `close`, because `close` is a Slint BUILTIN (Window.close) and a
    // callback of that name shadows it.
    callback request_close();

    // The running application version, shown in the About screen.
    in property <string> about-version: "0.0.0";

    // Latched by the AboutSlint element's own `init` handler below. This is
    // the runtime proof that the upstream widget was really INSTANTIATED —
    // not merely imported — and it is what the attribution unit test in
    // src/attribution.rs asserts on. Delete the AboutSlint element and this
    // stays false: that is the red-proof.
    out property <bool> about-slint-instantiated: false;

    VerticalBox {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: "ABOUT SHADOWMESH";
            font-size: 12px;
            font-weight: 900;
            letter-spacing: 0.12rem;
            color: #F1F5F9;
        }

        // The plate. The upstream widget paints its version/URL text with the
        // palette's default foreground, so dark text needs a light plate and
        // light text needs a dark one. Same contrast precedent as the QR
        // pairing plate already in this app ("white plate for contrast").
        Rectangle {
            height: 200px;
            border-radius: 12px;
            background: Palette.color-scheme == ColorScheme.dark ? #0F172A : white;

            AboutSlint {
                width: parent.width;
                height: parent.height;
                init => { root.about-slint-instantiated = true; }
            }
        }

        Text {
            text: "ShadowMesh desktop client — " + root.about-version;
            font-size: 12px;
            color: #94A3B8;
            wrap: word-wrap;
        }

        Text {
            text: "This application is distributed under the Slint Royalty-free Desktop, Mobile, and Web Applications License, Version 2.0. The full licence text ships in the LICENSES/ directory of the application. Slint is Copyright © SixtyFPS GmbH.";
            font-size: 12px;
            color: #94A3B8;
            wrap: word-wrap;
        }

        TextLink {
            label: "CLOSE";
            text-color: #94A3B8;
            font-size: 12px;
            clicked => { root.request_close(); }
        }
    }
}

// ============================================================
export component AppWindow inherits Window {
    in property <string> device_id: "UNKNOWN";
    in property <string> version: "0.0.0";
    in-out property <string> status: "IDLE";
    // RFC-018: desktop pairing — the session token the authorized device approves.
    in-out property <string> pairing-token: "";
    in-out property <bool> pairing-waiting: false;
    // v2 pairing UX: the scannable QR image of shadowmesh://pair/<token>.
    in-out property <image> pairing-qr;
    property <bool> show-pairing: false;
    callback request_pairing_generate();
    callback request_pairing_cancel();
    in-out property <bool> camouflage_active: false;
    in property <bool> is_team_member: false;
    in property <bool> is_team_admin: false;
    in-out property <bool> show_team_login: false;
    in-out property <bool> show_team_admin: false;
    in property <string> generated_member_token: "";
    in property <[MeshNode]> nodes: [];
    // Grouped view of the same nodes by country (drives the matrix UI).
    in property <[CountryGroup]> country-groups: [];

    // ---- The roster's CONDITION — its own line, its own slot ----
    //
    // ⚠️ These are NOT the `status` property. The status card is the
    // CONNECTION state's slot; the roster state's slot is the line under
    // the matrix panel (L6's `sm.roster.underList`). Sharing one slot was
    // F-7: the connection state overwrote the roster state, so the roster
    // state was present only when the last event happened to be a manifest
    // read — a live violation of A-10 and L10's RP-19.
    //
    // `roster-state-id` selects the marker shape and the state's tokens
    // (L6 §3.2, §3.3); it MUST match `RosterState::id()` in `src/rfc051.rs`.
    // `roster-state-label` is L6's §2.3 short label, alone; and
    // `roster-state-long-form` is the §2.3 long form, which is the
    // accessible DESCRIPTION of the merged node (A-5).
    in-out property <int> roster-state-id: 0;
    in-out property <string> roster-state-label: "";
    in-out property <string> roster-state-long-form: "";
    // P0-3: two-way binding target for the masked member-token TextInput
    in-out property <string> member_token: "";

    // RFC-011: autostart state (off by default per §4.3) and wipe trigger.
    in-out property <bool> autostart_enabled: false;

    // Physics-driver outputs (Rust-side velocity-tracked spring, 60Hz fixed step)
    in property <float> conn-strength: 0.0;
    in property <float> mesh-pulse: 1.0;

    callback request_connect(string);
    callback request_disconnect();
    callback request_camouflage(bool);
    callback request_refresh();
    callback request_member_login(string);
    callback request_create_member_token(string);
    // RFC-011 §4.3/§4.4
    callback request_autostart(bool);
    callback request_forensic_wipe();

    // F40 — Slint §2(a) attribution. Raised by the "Help > About ShadowMesh"
    // entry of the top level menu below; the Rust side opens the AboutWindow.
    callback request_show_about();

    title: camouflage_active ? "System Performance Monitor" : "ShadowMesh // Sovereignty Client";
    min-width: 400px;
    min-height: 700px;
    background: #0F172A; // Slate 900

    // ---- Top level menu (F40 — Slint §2(a)) ----
    // The licence requires the About screen to be "accessible from the top
    // level menu of the Application". `MenuBar` is Slint's built-in menu bar
    // element; the compiler lowers it to the platform's native menu bar where
    // one exists and to the style's in-window menu bar where it does not.
    //
    // The About entry is deliberately NOT hidden in camouflage mode: the
    // attribution must stay reachable in every state of the application.
    MenuBar {
        Menu {
            title: "Help";
            MenuItem {
                title: "About ShadowMesh";
                activated => { root.request_show_about(); }
            }
        }
    }

    VerticalBox {
        padding: 32px;
        spacing: 20px;
        alignment: start;

        // Precision Header
        HorizontalBox {
            alignment: space-between;
            Text {
                text: camouflage_active ? "SYSMON" : "SHADOWMESH";
                font-size: 18px;
                font-weight: 900;
                letter-spacing: 0.2rem;
                color: #FFFFFF;
            }
            // Team Badge
            if (is_team_member && !camouflage_active) : Rectangle {
                background: #6366F122;
                border-radius: 4px;
                border-width: 1px;
                border-color: #6366F144;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    Text { text: "TEAM"; font-size: 8px; font-weight: 900; color: #6366F1; }
                }
            }
            Text {
                text: version;
                font-size: 10px;
                font-weight: 700;
                color: #475569;
            }
        }

        // ---- Team Login Sheet ---- (entrance fade, Motion.heavy, interruptible)
        if (show_team_login) : VerticalBox {
            opacity: 0;
            animate opacity { duration: Motion.heavy; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            init => { self.opacity = 1.0; }
            spacing: 16px;

            Text { text: "TEAM MEMBER AUTHENTICATION"; font-size: 12px; font-weight: 900; color: #F1F5F9; }
            Text { text: "Enter your member token to bind this device."; font-size: 10px; color: #64748B; }

            // ZPII: the member token is captured in a masked TextInput bound
            // to a two-way property — never echoed, never logged in Rust.
            Rectangle {
                height: 48px;
                background: #00000033;
                border-radius: 8px;
                border-width: 1px;
                // AAA: focus ring on the token input (previously static border).
                border-color: token-input.has-focus ? #6366F1 : #334155;
                animate border-color { duration: Motion.fast; }
                token-input := TextInput {
                    text: root.member_token;
                    input-type: InputType.password;
                    font-size: 11px;
                    font-family: "Monospace";
                    color: #94A3B8;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            PhysicsButton {
                label: "AUTHENTICATE";
                clicked => { root.request_member_login(root.member_token); }
            }
            PhysicsButton {
                label: "CANCEL";
                clicked => { root.show_team_login = false; }
            }
        }

        // ---- Team Admin Sheet ---- (entrance fade, Motion.heavy, interruptible)
        if (show_team_admin) : VerticalBox {
            opacity: 0;
            animate opacity { duration: Motion.heavy; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            init => { self.opacity = 1.0; }
            spacing: 16px;

            Text { text: "TEAM ADMINISTRATION"; font-size: 12px; font-weight: 900; color: #F1F5F9; }
            Text { text: "Generate sovereignty tokens for your team members."; font-size: 10px; color: #64748B; }

            PhysicsButton {
                label: "CREATE MEMBER TOKEN";
                clicked => { root.request_create_member_token("New Member"); }
            }

            if (generated_member_token != "") : Rectangle {
                height: 48px;
                background: #10B98111;
                border-radius: 8px;
                border-width: 1px;
                border-color: #10B98144;
                Text { text: generated_member_token; font-size: 11px; font-family: "Monospace"; color: #10B981; vertical-alignment: center; horizontal-alignment: center; }
            }

            PhysicsButton {
                label: "BACK TO MESH";
                clicked => { root.show_team_admin = false; }
            }
        }

        if (!show_team_login && !show_team_admin) : VerticalBox {
            spacing: 20px;
            alignment: start;

            // Status Card — border glows when the encrypted mesh is live
            Rectangle {
                height: 100px;
                background: @linear-gradient(180deg, #1E293B 0%, #0F172A 100%);
                border-radius: 16px;
                border-width: 1px;
                border-color: (status == "CONNECTED" && !camouflage_active) ? #10B98155 : #334155;
                animate border-color { duration: Motion.heavy; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                VerticalBox {
                    alignment: center;
                    Text {
                        text: camouflage_active ? "NORMAL" : status;
                        horizontal-alignment: center;
                        font-size: 20px;
                        font-weight: 900;
                        color: status == "CONNECTED" && !camouflage_active ? #10B981 : #6366F1;
                        animate color { duration: Motion.medium; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    }
                    Text {
                        text: camouflage_active ? "SYSTEM STATE NOMINAL" : "ENCRYPTED MESH ACTIVE";
                        horizontal-alignment: center;
                        font-size: 9px;
                        font-weight: 700;
                        color: #475569;
                        visible: (status == "CONNECTED") || camouflage_active;
                        // Ambient breathing — driven by the Rust pulse oscillator
                        opacity: (status == "CONNECTED" && !camouflage_active)
                            ? mesh-pulse : 1.0;
                    }
                }

                // Connection strength bar — spring-driven, interruptible mid-flight
                Rectangle {
                    x: 8px;
                    y: parent.height - 5px;
                    height: 3px;
                    width: (parent.width - 16px)
                        * Math.min(Math.max(conn-strength, 0.0), 1.0);
                    border-radius: 2px;
                    background: @linear-gradient(90deg, #6366F1 0%, #10B981 100%);
                }
            }

            // Mesh Matrix Header
            HorizontalBox {
                alignment: space-between;
                Text {
                    text: camouflage_active ? "PROCESS THREADS" : "GLOBAL MESH FABRIC";
                    font-size: 9px;
                    font-weight: 900;
                    color: #64748B;
                    letter-spacing: 0.1rem;
                }
                TextLink {
                    label: "REFRESH";
                    text-color: #6366F1;
                    clicked => { root.request_refresh(); }
                }
            }

            // The roster panel AND the roster's state line, as one group: the
            // state line sits **immediately under the matrix panel** (L6's
            // §6.2 row 2), and the group keeps them together.
            VerticalBox {
                spacing: 4px;

                // Node Matrix — grouped by country so all Singapore nodes sit
                // together, all US nodes together, etc. Rust pre-groups into
                // country-groups (header label + its nodes); nodes stays the
                // flat list the core router consumes.
                //
                // ⚠️ **The empty matrix stays EMPTY.** No placeholder text, no
                // glyph, no error colour, no dash. A placeholder in the panel
                // would be a SECOND carrier of the roster state — which the
                // always-present line below already carries — and any
                // placeholder that says "no nodes" reads as "the fleet is
                // empty", which is FALSE: "empty" is a statement about the
                // connection, not about the fleet (L10 §2.1; L6 §6.3). The
                // panel keeps its frame and its fill, and an empty panel with
                // its frame reads as an empty panel — while an empty panel
                // with a broken-image glyph reads as a rendering failure.
                Rectangle {
                    background: #00000033;
                    border-radius: 12px;
                    clip: true;
                    height: 200px;

                    ScrollView {
                        VerticalBox {
                            alignment: start;
                            spacing: 8px;
                            padding: 8px;
                            for group in country-groups : VerticalLayout {
                                spacing: 2px;
                                CountryHeader { label: group.label; }
                                for node in group.nodes : NodeRow {
                                    node: node;
                                    camouflaged: camouflage_active;
                                }
                            }
                        }
                    }
                }

                // ⚠️ THE ROSTER STATE LINE — immediately under the matrix panel.
                //
                // One quiet line, always present, carrying the roster's
                // CONDITION (L6 §6.2). It is NOT the status card: the status
                // card is the connection's slot, and a roster fact rendered in
                // the connection card is incoherent AND conditionally present
                // (F-7).
                //
                // ⚠️ **In a disguised posture this line renders NOTHING**
                // (`visible: false`, which also removes it from the
                // accessibility tree): a roster-state line under a list reveals
                // the PRODUCT'S PRESENCE, which is exactly what the disguise
                // exists to prevent (L10's M-7, RP-20). This is a posture-level
                // suppression of the SURFACE — the state is never removed, and
                // the state line is present in every state otherwise (A-10,
                // M-6, RP-19).
                RosterStateLine {
                    state-id: root.roster-state-id;
                    label: root.roster-state-label;
                    long-form: root.roster-state-long-form;
                    visible: !camouflage_active;
                }
            }

            // Identity Info
            VerticalBox {
                spacing: 4px;
                Text {
                    text: camouflage_active ? "PROCESS ID" : "DEVICE IDENTITY";
                    font-size: 8px;
                    font-weight: 900;
                    color: #64748B;
                }
                Text {
                    text: camouflage_active ? "0x7F2A" : "0x" + device_id;
                    font-size: 11px;
                    font-family: "Monospace";
                    color: #94A3B8;
                }
            }

            // Camouflage Mode Toggle — real switch physics
            HorizontalBox {
                alignment: space-between;
                VerticalBox {
                    spacing: 2px;
                    Text { text: "CAMOUFLAGE MODE"; font-size: 10px; font-weight: 900; color: #FFFFFF; }
                    Text { text: "Swaps identity to decoy process"; font-size: 8px; color: #475569; }
                }
                ToggleSwitch {
                    active: root.camouflage_active;
                    toggled(new-state) => {
                        root.camouflage_active = new-state;
                        root.request_camouflage(new-state);
                    }
                }
            }

            if (!is_team_member && !camouflage_active) : TextLink {
                label: "SWITCH TO TEAM ACCOUNT";
                text-color: #6366F1;
                clicked => { root.show_team_login = true; }
            }

            if (is_team_admin && !camouflage_active) : TextLink {
                label: "TEAM ADMIN DASHBOARD";
                text-color: #10B981;
                clicked => { root.show_team_admin = true; }
            }

            Rectangle { }

            // RFC-011 §4.3: autostart toggle (off by default, user scope).
            TextLink {
                label: root.autostart_enabled ? "AUTOSTART: ON" : "AUTOSTART: OFF";
                text-color: root.autostart_enabled ? #10B981 : #64748B;
                clicked => { root.request_autostart(!root.autostart_enabled); }
            }

            // RFC-011 §4.4: forensic wipe — purge device identity and all
            // app-owned state; confirmation is the single-tap gravity here
            // (destructive action surfaced in the status line as WIPING...).
            TextLink {
                label: "FORENSIC WIPE";
                text-color: #EF4444;
                clicked => { root.request_forensic_wipe(); }
            }

            Rectangle { }

            // RFC-018: desktop pairing — display the session token for the
            // authorized device to approve; the daemon auto-activates on
            // approval (status truth flows back through CheckStatus).
            TextLink {
                label: root.show-pairing ? "PAIRING ▲" : "PAIR DEVICE";
                text-color: #38BDF8;
                clicked => { root.show-pairing = !root.show-pairing; }
            }

            if root.show-pairing : Rectangle {
                // Height must clear the tallest state. Previously 210px held a
                // 150px QR plus a wrapping token string, a status line and a
                // link, so the lower rows were clipped. The token string is no
                // longer rendered (it is the QR that gets scanned), which is
                // both the ZPII-safe choice and what makes the box fit.
                height: pairing-token == "" ? 88px : 248px;
                border-radius: 10px;
                border-width: 1px;
                border-color: #1E293B;
                background: #0F1118;
                // Spring-out curve per the Motion token contract (design-system
                // 03) — no ad-hoc easing outside the token family.
                animate height { duration: Motion.medium; easing: cubic-bezier(0.34, 1.30, 0.64, 1); }

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    alignment: center;

                    if pairing-token == "" : Text {
                        text: "Generate a pairing code, then scan it with your authorized phone.";
                        // 9px was below any legible floor; the design system
                        // requires accessible contrast and size.
                        font-size: 12px; color: #94A3B8;
                        horizontal-alignment: center; wrap: word-wrap;
                    }
                    // v2 pairing UX: the scannable QR (white plate for contrast).
                    if pairing-token != "" : Rectangle {
                        background: white;
                        border-radius: 6px;
                        height: 150px;
                        Image {
                            source: pairing-qr;
                            width: parent.height;
                            height: parent.height;
                        }
                    }
                    if pairing-token != "" : Text {
                        text: pairing-waiting ? "WAITING FOR APPROVAL — SCAN ON YOUR AUTHORIZED PHONE" : "APPROVED — ACTIVATED";
                        font-size: 12px; font-weight: 700; wrap: word-wrap;
                        color: pairing-waiting ? #94A3B8 : #10B981;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 18px;
                        alignment: center;
                        TextLink {
                            label: pairing-token == "" ? "GENERATE PAIRING CODE" : "REGENERATE";
                            text-color: #38BDF8;
                            clicked => { root.request_pairing_generate(); }
                        }
                        // Previously the only way out of a pending request was to
                        // regenerate it, so a code started by mistake could not
                        // be dismissed.
                        if pairing-token != "" : TextLink {
                            label: "CANCEL";
                            text-color: #64748B;
                            clicked => { root.request_pairing_cancel(); }
                        }
                    }
                }
            }

            Rectangle { }

            // Primary Action — tactile CTA with elevation physics
            PhysicsButton {
                label: (status == "CONNECTED" && !camouflage_active) ? "DISCONNECT"
                     : (camouflage_active ? "VIEW LOGS" : "SECURE CONNECTION");
                clicked => {
                    if (!camouflage_active) {
                        if (status == "CONNECTED") {
                            root.request_disconnect();
                        } else {
                            root.request_connect("best-node");
                        }
                    }
                }
            }
        }
    }
}
