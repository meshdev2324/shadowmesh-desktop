{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "shadowmesh-desktop",
  "version": "4.2.0",
  "identifier": "org.shadowmesh.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-data: 'self' data:; connect-src 'self' http://localhost:* https://api.shadowmesh.org"
    },
    "windows": [
      {
        "label": "main",
        "title": "ShadowMesh",
        "width": 400,
        "height": 840,
        "minWidth": 360,
        "minHeight": 640,
        "maxWidth": 1024,
        "maxHeight": 1366,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/shadowmesh-daemon"
    ],
    "publisher": "ShadowMesh Security",
    "copyright": "Copyright © 2026 ShadowMesh",
    "category": "Utility",
    "shortDescription": "Quantum-Secure Mesh VPN Client",
    "longDescription": "A hardened desktop client for the ShadowMesh network, featuring Quantum Tunneling and REALITY protocol support."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.shadowmesh.org/desktop/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW5zZXRfcHVibGljX2tleV9mb3Jfc2hhZG93bWVzaF91cGRhdGVyXzIwMjY="
    }
  }
}

